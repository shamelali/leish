{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/server/*": [
        "./lib/*"
      ],
      "@/lib/storage": [
        "./lib/storage"
      ],
      "@/lib/*": [
        "../shared/lib/*"
      ]
    },
    "target": "es2022"
  },
  "include": [
    "lib/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
