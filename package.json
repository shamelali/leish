{
  "name": "leish",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@leish/web",
    "dev:artist": "turbo dev --filter=@leish/artist",
    "dev:studio": "turbo dev --filter=@leish/studio",
    "build": "turbo build",
    "build:web": "turbo build --filter=@leish/web",
    "build:artist": "turbo build --filter=@leish/artist",
    "build:studio": "turbo build --filter=@leish/studio",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@prisma/engines",
      "@sentry/cli",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.0",
    "@opencode-ai/sdk": "^1.15.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "supabase": "^2.77.0",
    "turbo": "^2.9.18",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.22.0"
  }
}
