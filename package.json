{
  "name": "leish",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@leish/web",
    "dev:artist": "turbo dev --filter=@leish/artist",
    "dev:studio": "turbo dev --filter=@leish/studio",
    "build": "turbo build",
    "build:web": "turbo build --filter=@leish/web",
    "build:artist": "turbo build --filter=@leish/artist",
    "build:studio": "turbo build --filter=@leish/studio",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.0",
    "@opencode-ai/sdk": "^1.15.0",
    "supabase": "^2.77.0",
    "turbo": "^2.9.18",
    "typescript": "5.7.3"
  }
}
