# ─────────────────────────────────────────────────
# Leish Monorepo — Shared Environment Variables
# ─────────────────────────────────────────────────
# These vars are needed by ALL apps (root, artist, studio).
# Copy to .env.local in the root and/or each app as needed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
NEXT_PUBLIC_APP_URL=

STUDIO_SOURCE=mock
EXTERNAL_STUDIO_API_BASE_URL=
EXTERNAL_STUDIO_API_KEY=

# Billplz (payment gateway)
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_COLLECTION_ID_FULL=
BILLPLZ_COLLECTION_ID_DEPOSIT=
BILLPLZ_X_SIGNATURE=
BILLPLZ_CALLBACK_URL=

PAYMENT_SUCCESS_URL=
ALERT_WEBHOOK_URL=

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Cron jobs
CRON_SECRET=

# Email (Brevo)
BREVO_API_KEY=
FROM_EMAIL=hello@leish.my
FROM_NAME=Leish

# Email aliases
SUPPORT_EMAIL=support@leish.my
BILLING_EMAIL=billing@leish.my
MARKETING_EMAIL=marketing@leish.my
ADMIN_EMAIL=admin@leish.my
NOTIFICATIONS_EMAIL=notifications@leish.my
INFO_EMAIL=info@leish.my
STUDIO_EMAIL=studio@leish.my
ARTIST_EMAIL=artist@leish.my

# Google integrations
GOOGLE_CALENDAR_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AI Gateway
AI_GATEWAY_API_KEY=

# Cloudflare Web Analytics
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

