{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm turbo run build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/.next",
  "devCommand": "pnpm dev:web",
  "regions": ["sin1"],
  "images": {
    "sizes": [256, 384, 640, 750, 828, 1080, 1200, 1920],
    "remotePatterns": [
      { "protocol": "https", "hostname": "www.leish.my" },
      { "protocol": "https", "hostname": "*.supabase.co" }
    ]
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.leish.my" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/cleanup", "schedule": "0 0 * * *" },
    { "path": "/api/cron/reminders", "schedule": "0 9 * * *" },
    { "path": "/api/cron/webhook-monitor", "schedule": "0 12 * * *" },
    { "path": "/api/cron/booking-cleanup", "schedule": "0 6 * * *" }
  ]
}